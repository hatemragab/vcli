{
  "name": "@vcli/auth-runtime",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Narrow crypto mechanics for owner-controlled VCLI authentication",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./opaque": {
      "types": "./dist/opaque.d.ts",
      "import": "./dist/opaque.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "import": "./dist/password.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "import": "./dist/jwt.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "format:check": "prettier --check src test *.json *.md eslint.config.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:tests",
    "test": "node --experimental-test-module-mocks --test --test-concurrency=1 test/*.test.ts"
  },
  "peerDependencies": {
    "jose": "6.2.16",
    "argon2": "0.45.2"
  },
  "peerDependenciesMeta": {
    "jose": {
      "optional": true
    },
    "argon2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "argon2": "0.45.2",
    "eslint": "10.15.0",
    "jose": "6.2.16",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
