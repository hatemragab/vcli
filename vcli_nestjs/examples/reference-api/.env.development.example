# Optional: copy to .env.development and select it explicitly with APP_ENV_FILE.
# Prepare the local Mongo replica set and run explicit schema setup before the demo.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://127.0.0.1:3100
ALLOWED_ORIGINS=http://127.0.0.1:3100
DATABASE_URL=mongodb://127.0.0.1:57017/reference?replicaSet=rs0&directConnection=true
AUTH_DRIVER=local
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=var/storage
REALTIME_DRIVER=socketio
MAIL_DRIVER=capture
FCM_ENABLED=false
APNS_ENABLED=false
# Firebase profile: AUTH_DRIVER=firebase; use approved external credentials.
# FIREBASE_PROJECT_ID=your-test-project
# FIREBASE_METHODS=password,phone,google.com,apple.com
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/to/test-service-account.json
# S3 profile: STORAGE_DRIVER=s3 and a tested provider profile.
# S3_PROFILE=aws
# S3_BUCKET=your-private-test-bucket
# S3_REGION=us-east-1
# AWS credentials use the SDK's approved credential provider chain.
