# Safe names/placeholders only. Prefer platform-injected secrets.
# Run explicit database schema setup before starting the compiled app.
NODE_ENV=production
HOST=0.0.0.0
PORT=3100
PUBLIC_ORIGIN=https://api.example.invalid
ALLOWED_ORIGINS=https://app.example.invalid
DATABASE_URL=mongodb://REPLACE_WITH_PRIVATE_AUTHENTICATED_REPLICA_SET/reference?replicaSet=rs0
AUTH_DRIVER=firebase
FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
FIREBASE_METHODS=password,phone,google.com,apple.com
# GOOGLE_APPLICATION_CREDENTIALS is an external private mount when required.
STORAGE_DRIVER=s3
S3_PROFILE=aws
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
S3_REGION=us-east-1
# S3_ENDPOINT is required by an explicitly selected compatible profile.
MAIL_DRIVER=smtp
MAIL_FROM=reference@example.invalid
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER and SMTP_PASSWORD come from private secret injection.
REALTIME_DRIVER=socketio
FCM_ENABLED=false
APNS_ENABLED=false
EVIDENCE_DIRECTORY=/var/lib/reference/evidence
