{
  "schemaVersion": 1,
  "project": "test_notes_mongo",
  "environment": "development",
  "nodeEnvironment": "development",
  "target": "local",
  "targetVersion": "compose-v2",
  "topology": "single",
  "replicas": 1,
  "services": [
    {
      "id": "api",
      "kind": "api",
      "execution": "project",
      "resourceRef": "test-notes-mongo-development-api-165ef27917acb125",
      "image": "node:26.13.1-bookworm-slim",
      "command": ["node", "dist/main.js"],
      "ports": [
        {
          "port": 3100,
          "visibility": "loopback",
          "purpose": "HTTP liveness/readiness and selected public API"
        }
      ],
      "dependsOn": ["database"],
      "environment": [
        {
          "key": "ACCESS_TTL_SECONDS",
          "required": false,
          "secret": false,
          "defaultValue": "300"
        },
        {
          "key": "ALLOWED_ORIGINS",
          "required": false,
          "secret": false,
          "defaultValue": "https://app.example.invalid"
        },
        {
          "key": "APP_ENV_FILE",
          "required": false,
          "secret": true
        },
        {
          "key": "DATABASE_URL",
          "required": true,
          "secret": true
        },
        {
          "key": "EVIDENCE_DIRECTORY",
          "required": false,
          "secret": false,
          "defaultValue": "var/evidence"
        },
        {
          "key": "EVIDENCE_MAX_AGE_MS",
          "required": false,
          "secret": false,
          "defaultValue": "86400000"
        },
        {
          "key": "EVIDENCE_MAX_BYTES",
          "required": false,
          "secret": false,
          "defaultValue": "1048576"
        },
        {
          "key": "EVIDENCE_MAX_FILES",
          "required": false,
          "secret": false,
          "defaultValue": "3"
        },
        {
          "key": "HOST",
          "required": false,
          "secret": false,
          "defaultValue": "0.0.0.0"
        },
        {
          "key": "JWT_ACTIVE_KID",
          "required": true,
          "secret": false
        },
        {
          "key": "JWT_AUDIENCE",
          "required": false,
          "secret": false,
          "defaultValue": "app-api"
        },
        {
          "key": "JWT_ISSUER",
          "required": false,
          "secret": false,
          "defaultValue": "app"
        },
        {
          "key": "JWT_KEYS_JSON",
          "required": true,
          "secret": true
        },
        {
          "key": "JWT_MAX_FUTURE_ISSUED_SECONDS",
          "required": false,
          "secret": false,
          "defaultValue": "0"
        },
        {
          "key": "JWT_MAX_LIFETIME_SECONDS",
          "required": false,
          "secret": false,
          "defaultValue": "900"
        },
        {
          "key": "LOCAL_STORAGE_ROOT",
          "required": false,
          "secret": false,
          "defaultValue": "var/storage"
        },
        {
          "key": "NODE_ENV",
          "required": false,
          "secret": false,
          "defaultValue": "production"
        },
        {
          "key": "PORT",
          "required": false,
          "secret": false,
          "defaultValue": "3100"
        },
        {
          "key": "PUBLIC_ORIGIN",
          "required": false,
          "secret": false,
          "defaultValue": "https://api.example.invalid"
        },
        {
          "key": "RECENT_AUTH_SECONDS",
          "required": false,
          "secret": false,
          "defaultValue": "300"
        },
        {
          "key": "SESSION_TTL_SECONDS",
          "required": false,
          "secret": false,
          "defaultValue": "86400"
        },
        {
          "key": "UPLOAD_MAX_BYTES",
          "required": false,
          "secret": false,
          "defaultValue": "5242880"
        },
        {
          "key": "UPLOAD_TTL_SECONDS",
          "required": false,
          "secret": false,
          "defaultValue": "300"
        }
      ],
      "resources": {
        "memoryMiB": 512,
        "cpus": 1,
        "pids": 256
      },
      "health": {
        "scope": "readiness",
        "check": "GET /health/ready; liveness GET /health/live; not provider/end-to-end acceptance",
        "applicationAcceptance": false
      },
      "volumes": ["app-storage", "app-evidence"]
    },
    {
      "id": "database",
      "kind": "database",
      "execution": "compose",
      "resourceRef": "test-notes-mongo-development-database-fc0cc0121be381b7",
      "image": "mongo:8.0.38",
      "command": ["mongod", "--replSet", "rs0", "--bind_ip_all"],
      "ports": [
        {
          "port": 27017,
          "visibility": "loopback",
          "purpose": "selected native transactional database"
        }
      ],
      "dependsOn": [],
      "environment": [
        {
          "key": "VCLI_DATABASE_PORT",
          "required": false,
          "secret": false,
          "defaultValue": "27017"
        },
        {
          "key": "VCLI_WORKSPACE_ID",
          "required": true,
          "secret": false
        }
      ],
      "resources": {
        "memoryMiB": 512,
        "cpus": 1,
        "pids": 128
      },
      "health": {
        "scope": "process",
        "check": "Replica set initialized; primary writable and transaction topology checked separately",
        "applicationAcceptance": false
      },
      "volumes": ["database-data"]
    }
  ],
  "volumes": [
    {
      "id": "database-data",
      "resourceRef": "test-notes-mongo-development-database-data-95d984b2800fd3b1",
      "containerPath": "/data/db",
      "owner": "database",
      "mode": "0700",
      "purpose": "selected native database data, preserved on ordinary down",
      "backup": "required"
    },
    {
      "id": "app-storage",
      "resourceRef": "test-notes-mongo-development-app-storage-26b2fb6997e4a448",
      "containerPath": "/app/var/storage",
      "owner": "node",
      "mode": "0700",
      "purpose": "private immutable local objects and/or bounded transfer staging; never served as a static directory",
      "backup": "required"
    },
    {
      "id": "app-evidence",
      "resourceRef": "test-notes-mongo-development-app-evidence-d2527a9a7448d208",
      "containerPath": "/app/var/evidence",
      "owner": "node",
      "mode": "0700",
      "purpose": "same-user retained evidence, one publisher per source root; no shared replica volume",
      "backup": "required"
    }
  ],
  "externalRequirements": [],
  "jobs": [
    {
      "id": "release",
      "command": ["node", "dist/initialize-database.js"],
      "scheduler": "operator",
      "concurrency": "database-lock",
      "restart": "no",
      "dependsOn": ["database"]
    }
  ],
  "ingress": [
    {
      "service": "api",
      "port": 3100,
      "path": "/",
      "websocket": false,
      "stickiness": "none-single-instance",
      "tls": "operator",
      "deniedApiPaths": [
        "/api/internal",
        "/api/realtime/centrifugo",
        "/var",
        "/diagnostics"
      ]
    }
  ],
  "operatorReview": ["PUBLIC_ORIGIN", "ALLOWED_ORIGINS"],
  "pending": [
    "Artifact planning does not provision services, inject credentials, run release jobs, build images or prove readiness."
  ]
}
