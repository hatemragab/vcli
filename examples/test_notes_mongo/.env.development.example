# Set required blank values privately. Runtime environment overrides APP_ENV_FILE.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://127.0.0.1:3100
ALLOWED_ORIGINS=http://127.0.0.1:3100
DATABASE_URL=mongodb://127.0.0.1:27017/app?replicaSet=rs0&directConnection=true
SESSION_TTL_SECONDS=86400
RECENT_AUTH_SECONDS=300
JWT_KEYS_JSON=
JWT_ACTIVE_KID=
JWT_MAX_LIFETIME_SECONDS=900
JWT_MAX_FUTURE_ISSUED_SECONDS=0
JWT_ISSUER=app
JWT_AUDIENCE=app-api
ACCESS_TTL_SECONDS=300
LOCAL_STORAGE_ROOT=var/storage
UPLOAD_MAX_BYTES=5242880
UPLOAD_TTL_SECONDS=300
EVIDENCE_DIRECTORY=var/evidence
EVIDENCE_MAX_BYTES=1048576
EVIDENCE_MAX_FILES=3
EVIDENCE_MAX_AGE_MS=86400000
