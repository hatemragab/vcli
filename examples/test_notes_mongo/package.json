{
  "name": "test_notes_mongo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "nest build && node scripts/write-build-metadata.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "npm run check:architecture && npm run check:database && npm run lint && npm run typecheck",
    "check:architecture": "node scripts/check-architecture.ts",
    "check:database": "node scripts/check-database.ts",
    "prebuild": "npm run check:architecture && npm run check:database",
    "test": "node --test test/*.test.mjs",
    "db:initialize": "node dist/initialize-database.js",
    "release:apply": "node dist/initialize-database.js",
    "release:reconcile": "node dist/release/reconcile-command.js",
    "backup:create": "node dist/release/backup-command.js",
    "backup:restore": "node dist/release/restore-command.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@vcli/auth-runtime": "file:tools/vcli-auth-runtime",
    "argon2": "0.45.2",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "jose": "6.2.16",
    "mongoose": "9.12.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@vcli/cli": "file:tools/vcli",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
