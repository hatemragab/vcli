{
  "name": "vcli-reference-api-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hand-built expected-output reference for reviewing VCLI before generator implementation",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts/*.ts",
    "format": "prettier --write src test scripts docs *.json *.md",
    "format:check": "prettier --check src test scripts docs *.json *.md",
    "check": "npm run format:check && npm run lint && npm run check:database && npm run check:architecture && npm run typecheck && npm run typecheck:tests",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "check:architecture": "node scripts/check-architecture.ts",
    "prebuild": "npm run check:database && npm run check:architecture",
    "check:database": "node scripts/check-database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/platform-socket.io": "12.4.2",
    "@nestjs/platform-ws": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/websockets": "12.4.2",
    "argon2": "0.45.2",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "jose": "6.2.16",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "socket.io-client": "4.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
